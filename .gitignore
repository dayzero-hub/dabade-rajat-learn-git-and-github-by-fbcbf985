# Operating-system files that are about your machine, not the project
.DS_Store
Thumbs.db

# Editor settings — yours, not the team's
.vscode/
.idea/

# Local secrets (API keys, passwords, tokens) — once pushed they are public and
# stay in the history forever, so they must never reach a commit
.env
.env.*

# Installed dependencies — huge, rebuilt from the lockfile by `npm install`,
# so committing them only bloats the repo
node_modules/
